NODE_ENV=development
DATABASE_URL=postgres://controle_seller_app:troque-a-senha@localhost:5432/controle_seller
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/controle_seller
APP_DATABASE_ROLE=controle_seller_app
APP_DATABASE_ROLE_PASSWORD=troque-a-senha
WORKER_DATABASE_URL=postgres://controle_seller_worker:troque-a-senha-worker@localhost:5432/controle_seller
WORKER_DATABASE_ROLE=controle_seller_worker
WORKER_DATABASE_ROLE_PASSWORD=troque-a-senha-worker
SESSION_COOKIE_NAME=controle_seller_session
SESSION_TTL_HOURS=168
# JSON com chaves de 32 bytes em base64. Gere com: openssl rand -base64 32
CREDENTIAL_KEYS={"v1":"COLOQUE_UMA_CHAVE_BASE64_DE_32_BYTES"}
ACTIVE_CREDENTIAL_KEY_VERSION=v1
# Somente para migração temporária de envelopes v1; mantenha false em instalações novas.
ALLOW_LEGACY_CREDENTIAL_ENVELOPES=false
# Ative apenas atrás de proxy que sobrescreva X-Forwarded-For.
TRUST_PROXY=false
WORKER_NAME=worker-1
WORKER_HEARTBEAT_SECONDS=15
# URL HTTPS pública usada no callback e nos webhooks. Não inclua barra final.
APP_PUBLIC_URL=https://seller.exemplo.com
# Credenciais do aplicativo criado no painel Parceiros Nuvemshop.
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=
# A Nuvemshop exige identificação e contato no User-Agent.
NUVEMSHOP_USER_AGENT=ControleSeller/0.3 suporte@exemplo.com
# Caminhos locais permitidos após OAuth, separados por vírgula.
NUVEMSHOP_REDIRECT_ALLOWLIST=/configuracoes
NUVEMSHOP_TIMEOUT_MS=10000
# Aplicativo Meta com Facebook Login for Business e Marketing API v27.0.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Habilite apenas se o caso de uso exigir e a configuração tiver aprovação.
META_INCLUDE_BUSINESS_MANAGEMENT=false
META_REDIRECT_ALLOWLIST=/configuracoes
META_TIMEOUT_MS=15000
META_PURCHASE_ACTION_TYPES=purchase,omni_purchase,offsite_conversion.fb_pixel_purchase
